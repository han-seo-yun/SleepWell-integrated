<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/full_backup_content"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sleepwell"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="SleepWell 연구용 가상 데이터 데모"
            android:theme="@style/Theme.Sleepwell" />

        <activity
            android:name=".sync.PcConnectionActivity"
            android:exported="false"
            android:label="SleepWell PC 연결"
            android:theme="@style/Theme.Sleepwell" />

        <activity
            android:name=".user.UserActivity"
            android:exported="true"
            android:label="SleepWell"
            android:theme="@style/Theme.Sleepwell">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".user.DailyBackupJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <service
            android:name=".user.BackupRetryJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <receiver
            android:name=".user.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".sync.PrivacyPolicyActivity"
            android:exported="true"
            android:label="SleepWell 개인정보 안내"
            android:theme="@style/Theme.Sleepwell">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity>

        <!--
            내보낸 CSV/JSON을 다른 앱(Gmail·Drive)으로 넘기기 위한 통로.
            앱 전용 외부 저장소만 노출하므로 저장소 권한이 필요 없다.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
